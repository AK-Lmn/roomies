# ==============================================================================
# Roomies Standalone Environment Configuration
# ==============================================================================

# Database Connection (Optional for local dev)
# Leave unset or empty to use the built-in embedded PGLite (in-memory WASM Postgres).
# Set to a real PostgreSQL connection string for persistent data:
#
# Examples:
#   Local Postgres:  DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roomies"
#   Neon Postgres:   DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"
#   Supabase:        DATABASE_URL="postgresql://postgres.xyz:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL=""

# Better Auth Secret
# A random 32+ character string used to encrypt session tokens and passwords.
BETTER_AUTH_SECRET="roomies-local-development-secret-key-32-chars-long"

# Base URL of the running application
BETTER_AUTH_URL="http://localhost:8080"

# Spotify Developer API (Optional for "Connect Spotify" Live Sync)
# Get credentials for free at: https://developer.spotify.com/dashboard
# Redirect URI to add on Spotify Dashboard: http://localhost:8080/api/spotify/callback
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
